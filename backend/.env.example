# Copy this file to .env and fill in real values. .env is gitignored and
# never committed - this file is the checklist of what the app needs.

# Postgres connection string. Must point at a database with the pgvector
# extension enabled (see docker-compose.yml for local dev).
DATABASE_URL=postgresql+psycopg2://charity:charity@localhost:5433/charity_finder

# GlobalGiving Project API key - used by app/jobs/refresh_cache.py to pull
# project/organization data. Get one at https://www.globalgiving.org/api/
GLOBALGIVING_API_KEY=

# OpenAI API key - used to generate search-query and project-description
# embeddings (text-embedding-3-small). Billed per request; see
# app/services/embeddings.py.
OPENAI_API_KEY=

# Anthropic API key - used to generate cached project summaries. Billed per
# request; see app/services/summarization.py.
ANTHROPIC_API_KEY=

# Comma-separated list of origins allowed to call this API (CORS). Must
# match the frontend's real deployed URL in production, not just localhost.
ALLOWED_ORIGINS=http://localhost:5173
