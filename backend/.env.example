# Postgres (pgvector-enabled). Local: docker-compose default below. Prod: Supabase/Neon connection string.
DATABASE_URL=postgresql+psycopg2://charity:charity@localhost:5433/charity_finder

# GlobalGiving API
GLOBALGIVING_API_KEY=

# OpenAI — used only for text-embedding-3-small
OPENAI_API_KEY=

# Anthropic — used only for Claude Haiku project summaries
ANTHROPIC_API_KEY=

# CORS — comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173
